<Window x:Class="MeshCentralClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MeshCentralClient.App"
        Title="{app:T AppTitle}" Width="1000" Height="680" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- New version, in both views / Versión nueva, en las dos vistas -->
    <Border x:Name="UpdateBanner" Visibility="Collapsed" HorizontalAlignment="Left" Margin="16,8,240,0" Padding="10,6" CornerRadius="6"
            BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        <ProgressBar x:Name="UpdateProgress" Width="120" Height="4" Margin="12,0,0,0" Visibility="Collapsed" Maximum="1" />
        <Button x:Name="UpdateNowButton" Content="{app:T UpdateNow}" Margin="12,0,0,0" Click="UpdateNow_Click" Style="{DynamicResource AccentButtonStyle}" />
        <Button x:Name="UpdateLaterButton" Content="{app:T UpdateLater}" Margin="8,0,0,0" Click="UpdateLater_Click" />
      </StackPanel>
    </Border>

    <!-- Theme, in both views / Tema, en las dos vistas -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8,16,0">
      <TextBlock Text="{app:T Theme}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
      <ComboBox x:Name="ThemeBox" MinWidth="150" SelectionChanged="ThemeBox_SelectionChanged" AutomationProperties.Name="{app:T Theme}" />
    </StackPanel>

    <!-- ============ LOGIN / ENTRADA ============ -->
    <ScrollViewer x:Name="LoginPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Border MaxWidth="440" Margin="24" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{app:T AppTitle}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20" />

          <TextBlock Text="{app:T Server}" Margin="0,0,0,4" />
          <ComboBox x:Name="ServerBox" IsEditable="True" IsTextSearchEnabled="False" LostKeyboardFocus="ServerBox_LostKeyboardFocus"
                    SelectionChanged="ServerBox_SelectionChanged" ToolTip="{app:T ServerHint}" />
          <TextBlock Text="{app:T ServerHint}" Opacity="0.6" FontSize="12" Margin="0,2,0,12" />

          <TextBlock Text="{app:T Username}" Margin="0,0,0,4" />
          <TextBox x:Name="UserBox" Margin="0,0,0,12" />

          <TextBlock Text="{app:T Password}" Margin="0,0,0,4" />
          <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" />

          <CheckBox x:Name="RememberBox" Content="{app:T RememberPassword}" Margin="0,0,0,12" />

          <!-- Second factor / Segundo factor -->
          <Border x:Name="TwoFactorPanel" Visibility="Collapsed" Padding="12" Margin="0,0,0,12" CornerRadius="6"
                  BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <StackPanel>
              <TextBlock Text="{app:T TwoFactorTitle}" FontWeight="SemiBold" />
              <TextBlock x:Name="TwoFactorHelp" Text="{app:T TwoFactorHelp}" TextWrapping="Wrap" Margin="0,4,0,8" />
              <TextBox x:Name="CodeBox" FontSize="18" MaxLength="12" />
              <Button x:Name="EmailCodeButton" Content="{app:T SendEmailCode}" Visibility="Collapsed"
                      HorizontalAlignment="Left" Margin="0,8,0,0" Click="EmailCodeButton_Click" />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal">
            <Button x:Name="ConnectButton" Content="{app:T Connect}" IsDefault="True" MinWidth="120"
                    Click="ConnectButton_Click" Style="{DynamicResource AccentButtonStyle}" />
            <Button x:Name="CancelButton" Content="{app:T Cancel}" Margin="8,0,0,0" Visibility="Collapsed" Click="CancelButton_Click" />
            <Button x:Name="ForgetButton" Content="{app:T Forget}" Margin="8,0,0,0" Visibility="Collapsed" Click="ForgetButton_Click" />
          </StackPanel>
          <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="Collapsed" />

          <!-- Single sign-on the server offers / Inicio de sesión único que ofrece el servidor -->
          <StackPanel x:Name="SsoPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock Text="{app:T OrSignInWith}" Opacity="0.7" Margin="0,0,0,6" />
            <WrapPanel x:Name="SsoButtons" />
            <TextBlock Text="{app:T SsoHint}" Opacity="0.55" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>

          <TextBlock x:Name="VersionText" Opacity="0.5" FontSize="12" Margin="0,16,0,0" />

          <!-- Error / Error -->
          <Border x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,16,0,0" Padding="12" CornerRadius="6"
                  BorderThickness="1" BorderBrush="{StaticResource ErrorBrush}">
            <StackPanel>
              <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontWeight="SemiBold" />
              <TextBlock x:Name="ErrorAct" Margin="0,6,0,0" />
              <TextBlock x:Name="ErrorFooter" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75" />
              <Expander Header="{app:T Details}" Margin="0,8,0,0">
                <StackPanel>
                  <TextBox x:Name="ErrorTech" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160"
                           VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                  <Button Content="{app:T Copy}" HorizontalAlignment="Left" Margin="0,6,0,0" Click="CopyError_Click" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- ============ DEVICES / EQUIPOS ============ -->
    <DockPanel x:Name="DevicesPanel" Grid.Row="1" Visibility="Collapsed">
      <Grid DockPanel.Dock="Top" Margin="16,12,16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="SessionTitle" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="SessionSubtitle" Opacity="0.65" FontSize="12" />
        </StackPanel>
        <Grid Grid.Column="1" Margin="24,0" MaxWidth="420" VerticalAlignment="Center">
          <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="{app:T Search}"
                   AutomationProperties.Name="{app:T Search}" />
          <!-- Hint while empty / Pista mientras está vacío -->
          <TextBlock x:Name="SearchHint" Text="{app:T Search}" IsHitTestVisible="False" Opacity="0.55"
                     Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RefreshButton" Content="{app:T Refresh}" Click="Refresh_Click" Margin="0,0,8,0" />
          <Button x:Name="DisconnectButton" Content="{app:T Disconnect}" Click="Disconnect_Click" />
        </StackPanel>
      </Grid>

      <Border x:Name="LostBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="16,0,16,8" Padding="10" CornerRadius="6"
              BorderThickness="1" BorderBrush="{StaticResource ErrorBrush}">
        <DockPanel>
          <Button x:Name="ReconnectButton" DockPanel.Dock="Right" Content="{app:T Reconnect}" Click="Reconnect_Click" />
          <TextBlock x:Name="LostText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="16,6,16,10" Opacity="0.65" />

      <Grid>
        <ListView x:Name="DeviceList" Margin="16,0,16,0" MouseDoubleClick="DeviceList_MouseDoubleClick">
          <ListView.ContextMenu>
            <ContextMenu Opened="DeviceMenu_Opened">
              <MenuItem x:Name="TerminalItem" Header="{app:T OpenTerminal}" Click="OpenTerminal_Click" />
              <MenuItem x:Name="PowerShellItem" Header="{app:T OpenPowerShell}" Click="OpenPowerShell_Click" />
              <MenuItem x:Name="FilesItem" Header="{app:T OpenFiles}" Click="OpenFiles_Click" />
              <Separator />
              <MenuItem Header="{app:T OpenInBrowser}" Click="OpenInBrowser_Click" />
              <MenuItem Header="{app:T CopyName}" Click="CopyName_Click" />
            </ContextMenu>
          </ListView.ContextMenu>
          <ListView.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,4" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListView.GroupStyle>
          <ListView.View>
            <GridView>
              <GridViewColumn Width="34">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Ellipse Width="10" Height="10" ToolTip="{Binding Status}">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{StaticResource OfflineBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                              <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn x:Name="ColName" Width="240" DisplayMemberBinding="{Binding Name}" />
              <GridViewColumn x:Name="ColOs" Width="300" DisplayMemberBinding="{Binding Os}" />
              <GridViewColumn x:Name="ColAddress" Width="140" DisplayMemberBinding="{Binding Address}" />
              <GridViewColumn x:Name="ColTags" Width="180" DisplayMemberBinding="{Binding Tags}" />
            </GridView>
          </ListView.View>
        </ListView>
        <TextBlock x:Name="EmptyText" Text="{app:T NoDevices}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.65" Visibility="Collapsed" TextWrapping="Wrap" Margin="24" />
      </Grid>
    </DockPanel>
  </Grid>
</Window>
