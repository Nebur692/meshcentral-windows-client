<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MeshCentralClient.App</RootNamespace>
    <AssemblyName>MeshCentralClient</AssemblyName>
    <!-- Fluent (Windows 11) theme is still flagged experimental. / El tema Fluent aún figura como experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The single-file exe carries .NET and WPF: compressed it is far smaller. / El exe de un fichero lleva .NET y WPF: comprimido pesa mucho menos. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <!-- DPAPI (System.Security.Cryptography.ProtectedData) comes with the Windows Desktop framework.
       DPAPI (System.Security.Cryptography.ProtectedData) viene con el framework de escritorio de Windows. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <!-- Web pages shown in WebView2 (terminal), embedded so the app stays a single file.
         Páginas que se ven en WebView2 (terminal), incrustadas para que la app siga siendo un solo fichero. -->
    <EmbeddedResource Include="Assets\web\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeshCentralClient.Core\MeshCentralClient.Core.csproj" />
  </ItemGroup>
</Project>
