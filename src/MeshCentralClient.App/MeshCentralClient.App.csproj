<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MeshCentralClient.App</RootNamespace>
    <AssemblyName>MeshCentralClient</AssemblyName>
    <!-- Fluent (Windows 11) theme is still flagged experimental. / El tema Fluent aún figura como experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <!-- DPAPI (System.Security.Cryptography.ProtectedData) comes with the Windows Desktop framework.
       DPAPI (System.Security.Cryptography.ProtectedData) viene con el framework de escritorio de Windows. -->
  <ItemGroup>
    <ProjectReference Include="..\MeshCentralClient.Core\MeshCentralClient.Core.csproj" />
  </ItemGroup>
</Project>
